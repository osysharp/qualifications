// Everything the boat hire says to the kit: its roles and its answers to the kit's policies, its settings, the one place
// it asks the kit (a boat going out), and what it does when the kit tells it something.

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Qualifications;

[Role] enum HireRole { Authenticator, Customer, [Label("Dock hand")] DockHand, Manager }

policy IsCustomer => RoleGrant.Any(g => g.Member == user && g.Role == HireRole.Customer);
policy IsDockHand => RoleGrant.Any(g => g.Member == user && g.Role == HireRole.DockHand);
policy IsManager => RoleGrant.Any(g => g.Member == user && g.Role == HireRole.Manager);

/// The dock team records briefings and checks licences; the manager decides what is recognised and what a waiver says.
policy IssuesQualifications => IsDockHand || IsManager;
policy ManagesQualificationKinds => IsManager;

/// A parent acts for the child they made an account for.
policy ActsForHolder(Principal holder) =>
  holder == user || ManagedAccountRequest.Any(r => r.Account == holder && r.Guardian == user);

/// A customer may make an account for a child they bring.
policy MakesManagedAccounts => IsCustomer;

app.Accounts = new AccountsSetup { AppName = "Lakeside Boat Hire", SignupRole = HireRole.Customer };
app.Qualifications = new QualificationsSetup { RenewalNoticeDays = 30 };

/// A boat out on the lake — the hire's own record.
entity Hire {
  [Required("Who is the skipper?")] Principal Skipper;
  [MaxLength(40)] string Boat = "";
  DateTime At = DateTime.UtcNow;
  security { allow read when IsAuthenticated; allow create when IssuesQualifications; }
}

/// What a boat needs of its skipper.
List<string> SkipperNeeds() { return ["skipper-licence", "safety-briefing", "hire-waiver"]; }

/// The dock hands a boat out — refused, with the kit's sentence, to somebody missing anything it needs.
[Server, Authorize(IssuesQualifications)]
public Hire HandOutBoat(Principal skipper, string boat) {
  var why = QualificationGap(skipper, SkipperNeeds());
  if (why != "") { throw new ValidationException(why); }
  var h = new Hire { Skipper = skipper, Boat = boat };
  UnitOfWork.Commit();
  return h;
}

/// What the hire heard from the kit, one row per event — a stand-in for the mail it would send.
entity Heard {
  [MaxLength(40)] string Event = "";
  [MaxLength(200)] string Detail = "";
  security { allow read when IsAuthenticated; }
}

[On] void HearRecorded(QualificationRecorded e) { new Heard { Event = "recorded", Detail = e.Qualification.Kind.Key + ":" + e.Qualification.Holder.DisplayName }; }
[On] void HearSubmitted(QualificationSubmitted e) { new Heard { Event = "submitted", Detail = e.Qualification.Kind.Key }; }
[On] void HearRejected(QualificationRejected e) { new Heard { Event = "rejected", Detail = e.Qualification.Reason }; }
[On] void HearRevoked(QualificationRevoked e) { new Heard { Event = "revoked", Detail = e.Qualification.Kind.Key + ":" + e.Qualification.Reason }; }
[On] void HearExpiringSoon(QualificationExpiringSoon e) { new Heard { Event = "expiringsoon", Detail = e.Qualification.Kind.Key + ":" + e.Qualification.Holder.DisplayName }; }
[On] void HearExpired(QualificationExpired e) { new Heard { Event = "expired", Detail = e.Qualification.Kind.Key + ":" + e.Qualification.Holder.DisplayName }; }
