// The producer's test project for Osysharp.Qualifications — a boat hire on a lake: a skipper's licence customers bring and
// staff verify, a safety briefing the dock team gives every year, a hire waiver customers sign (a parent for a child who
// never signs in — a managed account of Osysharp.UserAccounts), and a first-aid certificate staff hold. A boat goes out only
// to somebody who holds what it needs.
app QualificationsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Qualifications@0;
  use Osysharp.Storage;
  use Osysharp.Ui;
  use Osysharp.Workflow;
}
