// The one call: does a person hold it on a day, and when not, why not — and the hire's own use of it at the dock.

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Qualifications;

[Test(Lake)]
[runas(Dan)]
void a_check_says_valid_expired_missing_or_revoked_in_a_sentence() {
  var ada = CheckQualification(Ada, "safety-briefing");
  Assert.True(ada.IsValid);
  Assert.Equal("Safety briefing is valid until 28 February 2027.", ada.Reason);
  var bo = CheckQualification(Bo, "safety-briefing");
  Assert.Equal(QualificationState.Expired, bo.State);
  Assert.Equal("Safety briefing expired on 30 September 2026.", bo.Reason);
  Assert.Equal("No Skipper's licence on record.", CheckQualification(Eve, "skipper-licence").Reason);
  Assert.Equal("Hire waiver has not been signed.", CheckQualification(Eve, "hire-waiver").Reason);
  RevokeQualification(ada.Qualification!, "Briefed the wrong person");
  Assert.Equal("Safety briefing was revoked: Briefed the wrong person.", CheckQualification(Ada, "safety-briefing").Reason);
  Assert.Equal("There is no qualification kind 'sailing'.", Assert.Throws<ValidationException>(() => CheckQualification(Ada, "sailing")).Message);
}

[Test(Lake)]
[runas(Dan)]
void a_check_on_a_day_counts_the_last_day_and_not_the_one_after() {
  Assert.True(HasValidQualification(Ada, "safety-briefing", new DateOnly(2027, 2, 28)));
  Assert.False(HasValidQualification(Ada, "safety-briefing", new DateOnly(2027, 3, 1)));
  Assert.False(HasValidQualification(Ada, "safety-briefing", new DateOnly(2026, 2, 28)));
}

[Test(Lake)]
[runas(Dan)]
void a_month_end_clamps_and_a_kind_that_does_not_lapse_never_does() {
  Assert.Equal(new DateOnly(2027, 2, 27), QualificationValidUntil(new DateOnly(2027, 1, 28), 1));
  Assert.Null(QualificationValidUntil(new DateOnly(2027, 1, 28), null));
}

[Test(Lake)]
[runas(Dan)]
void a_renewal_counts_and_the_most_favourable_qualification_decides() {
  RecordQualification(Bo, "safety-briefing");
  var bo = CheckQualification(Bo, "safety-briefing");
  Assert.True(bo.IsValid);
  Assert.Equal(new DateOnly(2027, 11, 1), bo.ValidUntil);
}

[Test(Lake)]
[runas(Dan)]
void the_dock_hands_a_boat_only_to_somebody_who_holds_everything_it_needs() {
  Assert.Equal("No Skipper's licence on record.", Assert.Throws<ValidationException>(() => HandOutBoat(Ada, "Heron")).Message);
  RecordQualification(Ada, "skipper-licence", new DateOnly(2024, 5, 1), "PB-20391", "Royal Yachting Association");
  Assert.Equal("Hire waiver has not been signed.", Assert.Throws<ValidationException>(() => HandOutBoat(Ada, "Heron")).Message);
  AdaSigns();
  Assert.Equal("Heron", HandOutBoat(Ada, "Heron").Boat);
  Assert.Equal(3, MissingQualifications(Bo, ["skipper-licence", "safety-briefing", "hire-waiver"]).Count);
}

[Test(Lake)]
[runas(Ada)]
void a_person_checks_themself_and_learns_nothing_of_anybody_else() {
  Assert.True(CheckQualification(Ada, "safety-briefing").IsValid);
  // To Ada, Bo has nothing on record — she may not read his.
  Assert.Equal(QualificationState.Missing, CheckQualification(Bo, "safety-briefing").State);
}
