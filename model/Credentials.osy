// The data of Osysharp.Qualifications — the kinds an organisation recognises, the texts a waiver is signed on, the
// qualifications people hold and the evidence behind them — and what the kit asks its app and tells it.

namespace Osysharp.Qualifications;

using Osysharp.Identity;
using Osysharp.Storage;

// ── what the app answers ────────────────────────────────────────────────────────────────────────────────────────────

/// THE SEAM — who records qualifications for anybody, verifies what people submit, revokes, and reads everybody's.
/// Nobody, until the app says: `policy IssuesQualifications => IsStaff;`.
virtual policy IssuesQualifications => false;

/// THE SEAM — who decides what kinds exist and publishes the text a waiver is signed on. Whoever issues, until the app
/// narrows it: `policy ManagesQualificationKinds => IsAdmin;`.
virtual policy ManagesQualificationKinds => IssuesQualifications;

/// THE SEAM — who may look up anybody's qualifications (to let them in, to put them on a shift) without issuing any.
/// Whoever issues, until the app widens it: `policy ChecksQualifications => IsStaff || IsDoorTeam;`.
virtual policy ChecksQualifications => IssuesQualifications;

/// THE SEAM — whether the caller acts for `holder`: reads their qualifications, signs a waiver for them, submits evidence
/// for them. The holder themself, until the app widens it — a parent for a child:
/// `policy ActsForHolder(Principal holder) => holder == user || Guardian.Any(g => g.Child == holder && g.Parent == user);`.
virtual policy ActsForHolder(Principal holder) => holder == user;

/// How the app runs qualifications — `app.Qualifications = new QualificationsSetup { … }`. Every member has a working default.
[AppSetting("Qualifications")]
public class QualificationsSetup {
  /// How many days before a qualification lapses its holder is told (`QualificationExpiringSoon`), unless its kind says
  /// otherwise. 0: no notice.
  public int RenewalNoticeDays = 30;
  /// Whether people may submit a qualification of their own (a certificate they hold) for staff to verify.
  public bool HoldersSubmit = true;
}

// ── the data ────────────────────────────────────────────────────────────────────────────────────────────────────────

/// What sort of thing a kind is — for grouping and wording. ⚠ Appended, never inserted.
public enum QualificationCategory {
  [Label("Licence")] Licence,
  [Label("Certificate")] Certificate,
  [Label("Induction")] Induction,
  [Label("Waiver")] Waiver,
  [Label("Check")] Check,
  [Label("Other")] Other,
}

/// A kind of qualification an organisation recognises: "Forklift licence", "Site induction", "Activity waiver".
public entity QualificationKind {
  /// The stable key code refers to ("forklift-licence"); it never changes once the kind exists.
  [Required, Unique("A qualification kind with this key already exists."), Immutable, MaxLength(60)] string Key;
  /// What people read ("Forklift licence").
  [Required, MaxLength(120)] string Name;
  [MaxLength(500)] string Description = "";
  QualificationCategory Category = QualificationCategory.Certificate;
  /// How many months one is valid for from the day it is issued; empty: it does not lapse.
  [Min(1), Max(600)] int? ValidForMonths;
  /// Days before it lapses that its holder is told; empty: the app's `RenewalNoticeDays`.
  [Min(0), Max(365)] int? NoticeDays;
  /// The person signs it themselves (or whoever acts for them), on the kind's current text — a waiver, a declaration.
  bool SignedByHolder = false;
  /// One a person submits needs a file (a scan, a photo) before it is verified.
  bool NeedsEvidence = false;
  /// Retired kinds are kept — qualifications point at them — and issued no more.
  bool Active = true;
  int SortOrder = 0;

  security {
    allow read when IsAuthenticated || IsAnonymous;
    allow create, update when ManagesQualificationKinds;
  }
}

/// One version of the text a kind is signed on. Never changed: a new wording is a new version, and every signature
/// keeps the version it was given on.
[Unique(Kind, Version, "That version of the text already exists.")]
public entity QualificationText {
  [Required, Immutable] QualificationKind Kind;
  [Immutable, Min(1)] int Version;
  [Required, Immutable, MaxLength(20000)] string Body;
  [Immutable] DateTime PublishedAt = DateTime.UtcNow;
  [Immutable] Principal? PublishedBy;

  security {
    allow read when IsAuthenticated || IsAnonymous;
    allow create when ManagesQualificationKinds;
    deny create except via PublishQualificationText;
  }
}

/// Where a qualification stands. ⚠ Appended, never inserted. Whether one has LAPSED is not a status — it is its dates.
public enum QualificationStatus {
  /// In force from `IssuedOn` (until `ValidUntil`, when it has one).
  [Label("Recorded")] Recorded,
  /// Submitted by the person, waiting for staff to look at the evidence.
  [Label("Waiting for verification")] Submitted,
  /// Staff looked and did not accept it — `Reason` says why.
  [Label("Not accepted")] Rejected,
  /// Taken back — `Reason` says why.
  [Label("Revoked")] Revoked,
}

/// Where a qualification's own clock is — `QualificationLife` owns it.
public enum QualificationPhase { Running, Over }

/// A qualification one person holds: of a kind, from a day, until a day (the LAST day it holds). Made only by the kit's
/// functions — recorded, signed or submitted — and never edited into something else: renewing is a new one; revoking
/// and rejecting keep the row, with the reason.
[SuppressWarning("cost-row-rule-asked-of-every-caller")]   // the holder's rule is asked of everyone who holds one, by design
public entity Qualification {
  [Required, Immutable] Principal Holder;
  [Required, Immutable] QualificationKind Kind;
  /// The first day it holds.
  [Immutable] DateOnly IssuedOn;
  /// The last day it holds; empty when its kind does not lapse.
  [Immutable] DateOnly? ValidUntil;
  /// The number on it — a licence number, a certificate id.
  [Immutable, MaxLength(100), Classification(Personal.Content)] string Reference = "";
  /// Who issued it outside this app — "Royal Yachting Association", "St John Ambulance".
  [Immutable, MaxLength(120)] string IssuedBy = "";
  QualificationStatus Status = QualificationStatus.Recorded;
  /// Who put it on record — staff, or the person who submitted or signed it.
  [Immutable] Principal? RecordedBy;
  [Immutable] DateTime RecordedAt = DateTime.UtcNow;
  /// For a signed one: the text version signed, who signed (the holder, or whoever acts for them), the name they typed,
  /// and when.
  [Immutable] QualificationText? Text;
  [Immutable] Principal? SignedBy;
  [Immutable, MaxLength(200), Classification(Personal.Content)] string SignedName = "";
  [Immutable] DateTime? SignedAt;
  /// Who verified a submitted one, and when.
  Principal? VerifiedBy;
  DateTime? VerifiedAt;
  /// Revoked or rejected: who, when, and why.
  Principal? ClosedBy;
  DateTime? ClosedAt;
  [MaxLength(300), Classification(Personal.Content)] string Reason = "";
  [MaxLength(500), Classification(Personal.Content)] string Note = "";
  /// The lapse its holder was last told about, so each is told once.
  DateOnly? NoticeFor;
  QualificationPhase Phase;          // no default — QualificationLife owns it

  invariant ValidUntil == null || ValidUntil >= IssuedOn message "A qualification cannot lapse before it is issued.";

  security {
    allow read when IsAuthenticated where ActsForHolder(Holder);
    allow read when ChecksQualifications || IssuesQualifications;
    allow create, update when IsAuthenticated;
    deny create except via RecordQualification, SignQualification, SubmitQualification;
    deny update Status except via VerifyQualification, RejectQualification, RevokeQualification;
    deny update VerifiedBy, VerifiedAt except via VerifyQualification;
    deny update ClosedBy, ClosedAt, Reason except via RejectQualification, RevokeQualification;
    deny update Note except via VerifyQualification;
    deny update NoticeFor;
    allow delete when IssuesQualifications;
    deny delete except via EraseQualificationsOf;
  }
}

/// A file behind a qualification — a scan of the certificate, a photo of the licence. Readable wherever the qualification is.
[SuppressWarning("cost-row-rule-asked-of-every-caller")]
public entity QualificationEvidence {
  [Required, Immutable] Qualification Qualification;
  [Required, Immutable, Attachment] FileAsset File;
  [Immutable, MaxLength(200)] string Name = "";
  [Immutable] DateTime AddedAt = DateTime.UtcNow;
  [Immutable] Principal? AddedBy;

  security {
    allow read when IsAuthenticated where ActsForHolder(Qualification.Holder);
    allow read when ChecksQualifications || IssuesQualifications;
    allow create when IsAuthenticated;
    deny create except via AttachEvidence;
    allow delete when IssuesQualifications;
    deny delete except via EraseQualificationsOf;
  }
}

// ── what the kit tells the app ──────────────────────────────────────────────────────────────────────────────────────

/// A qualification is in force: recorded by staff, signed, or verified.
[Event("Qualification recorded")]
public sealed class QualificationRecorded { public Qualification Qualification; }

/// A person submitted a qualification; it waits for staff to verify it.
[Event("Qualification submitted")]
public sealed class QualificationSubmitted { public Qualification Qualification; }

/// Staff did not accept a submitted qualification — `Qualification.Reason` says why.
[Event("Qualification not accepted")]
public sealed class QualificationRejected { public Qualification Qualification; }

/// A qualification was taken back — `Qualification.Reason` says why.
[Event("Qualification revoked")]
public sealed class QualificationRevoked { public Qualification Qualification; }

/// A qualification lapses within its notice and nothing newer of its kind replaces it — the moment to ask its holder to
/// renew it.
[Event("Qualification expiring soon")]
public sealed class QualificationExpiringSoon { public Qualification Qualification; }

/// A qualification lapsed, and nothing newer of its kind replaces it.
[Event("Qualification expired")]
public sealed class QualificationExpired { public Qualification Qualification; }
